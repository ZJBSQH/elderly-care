<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.elderlycare.mapper.RecordMapper">

    <!-- 根据任务 ID 查询最新记录 -->
    <select id="selectByTaskId" resultType="com.elderlycare.pojo.entity.Record">
        SELECT * FROM record
        WHERE task_id = #{taskId}
        ORDER BY record_time DESC
            LIMIT 1
    </select>

</mapper>
